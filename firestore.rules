rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & ROLE DEFINITIONS
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAuthUid(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Safe retrieval of user metadata document: users/{uid}
    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return hasUserDoc() && ('role' in getUserDoc()) ? getUserDoc().role : 'customer';
    }

    function getUserPhone() {
      return hasUserDoc() && ('phone' in getUserDoc()) 
        ? getUserDoc().phone 
        : (request.auth.token.phone_number != null ? request.auth.token.phone_number : '');
    }

    function getUserShopId() {
      return hasUserDoc() && ('shop_id' in getUserDoc()) ? getUserDoc().shop_id : '';
    }

    // Super Admin: Has highest privileges
    function isSuperAdmin() {
      return isAuthenticated() && (
        getUserRole() == 'super_admin' ||
        (request.auth.token.role != null && request.auth.token.role == 'super_admin') ||
        exists(/databases/$(database)/documents/super_admins/$(request.auth.uid)) ||
        getUserPhone() in ['9999999999', '+919999999999']
      );
    }

    // Phone normalizer helper for comparing 10-digit phone numbers
    function isMatchingPhone(phone) {
      return phone is string && (
        phone == getUserPhone() ||
        (getUserPhone().size() >= 10 && phone.size() >= 10 && 
         getUserPhone()[getUserPhone().size() - 10:] == phone[phone.size() - 10:])
      );
    }

    // Shop Owner: Strictly isolated to their specific shop
    // Validated against authoritative shops/{shopId} record to prevent spoofing
    function isShopOwner(shopId) {
      return isAuthenticated() && shopId is string && shopId.size() > 0 && (
        isSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/shops/$(shopId)) && (
            (get(/databases/$(database)/documents/shops/$(shopId)).data.owner_uid == request.auth.uid) ||
            isMatchingPhone(get(/databases/$(database)/documents/shops/$(shopId)).data.mobile) ||
            (
              'authorized_staff' in get(/databases/$(database)/documents/shops/$(shopId)).data &&
              get(/databases/$(database)/documents/shops/$(shopId)).data.authorized_staff.hasAny([getUserPhone(), request.auth.uid])
            )
          )
        )
      );
    }

    // Order State Machine transition validation:
    // Enforces: Pending -> Accepted -> Packing/Packed -> Ready -> Out for Delivery -> Delivered
    // Plus: Rejection, Cancellation, Delivery_Failed transitions
    // And TERMINAL INVARIANCE: Delivered, Cancelled, and Rejected orders CANNOT be altered without super_admin!
    function isValidOrderTransition(currentStatus, nextStatus) {
      return currentStatus == nextStatus ||
        (currentStatus == 'Pending' && nextStatus in ['Accepted', 'Packing', 'Packed', 'Ready', 'Rejected', 'Cancelled']) ||
        (currentStatus == 'Accepted' && nextStatus in ['Packing', 'Packed', 'Ready', 'Cancelled']) ||
        ((currentStatus == 'Packing' || currentStatus == 'Packed') && nextStatus in ['Ready', 'Out for Delivery', 'Delivered', 'Cancelled']) ||
        (currentStatus == 'Ready' && nextStatus in ['Out for Delivery', 'Delivered', 'Cancelled']) ||
        (currentStatus == 'Out for Delivery' && nextStatus in ['Delivered', 'Delivery_Failed', 'Cancelled']) ||
        (currentStatus == 'Delivery_Failed' && nextStatus in ['Out for Delivery', 'Cancelled']);
    }

    // =========================================================================
    // 1. USERS COLLECTION (Role and Profile Registry)
    // =========================================================================
    match /users/{userId} {
      // Users can read their own profile; Super Admin can read all
      allow read: if isSuperAdmin() || isAuthUid(userId);

      // Users can create their own initial profile with 'customer' or 'shop_owner' role.
      // Privilege escalation to 'super_admin' is strictly forbidden!
      allow create: if isAuthUid(userId)
                    && request.resource.data.role in ['customer', 'shop_owner']
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() >= 10
                    && request.resource.data.phone.size() <= 15
                    && (
                      !('shop_id' in request.resource.data) ||
                      request.resource.data.shop_id == '' ||
                      isShopOwner(request.resource.data.shop_id)
                    );

      // Users can update their profile; cannot change their role to super_admin or alter shop_id without authorization
      allow update: if isSuperAdmin() || (
        isAuthUid(userId)
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role || (resource.data.role == 'customer' && request.resource.data.role == 'shop_owner'))
        && request.resource.data.role != 'super_admin'
        && (
          !('shop_id' in request.resource.data) ||
          request.resource.data.shop_id == resource.data.shop_id ||
          request.resource.data.shop_id == '' ||
          isShopOwner(request.resource.data.shop_id)
        )
      );

      allow delete: if isSuperAdmin();

      // FCM device registration tokens for user
      match /fcm_tokens/{tokenId} {
        allow read, write: if isSuperAdmin() || isAuthUid(userId);
      }
    }

    // Super admin explicit registry
    match /super_admins/{adminId} {
      allow read, write: if isSuperAdmin();
    }

    // =========================================================================
    // 2. SHOPS COLLECTION (Multi-Tenant Shop Isolation)
    // =========================================================================
    match /shops/{shopId} {
      // Active approved shops can be viewed by anyone/customers to browse catalog.
      // Inactive/pending shops can only be viewed by their Owner or Super Admin.
      allow read: if isSuperAdmin() 
                  || (resource.data.is_active == true && resource.data.status == 'approved')
                  || isShopOwner(shopId);

      // New shop registration:
      // Status MUST be 'pending' and is_active MUST be false on initial creation.
      // Self-approval is completely blocked!
      allow create: if isAuthenticated()
                    && request.resource.data.is_active == false
                    && request.resource.data.status == 'pending'
                    && request.resource.data.shop_name is string
                    && request.resource.data.shop_name.size() > 0
                    && request.resource.data.shop_name.size() <= 100
                    && request.resource.data.mobile is string
                    && request.resource.data.mobile.size() >= 10;

      // Update shop details:
      // Super admin can update everything (approve, reject, deactivate).
      // Shop owner can only update their own shop info (address, UPI, timings, pin),
      // and CANNOT self-approve (is_active and status cannot be modified by owner).
      allow update: if isSuperAdmin() || (
        isShopOwner(shopId)
        && request.resource.data.is_active == resource.data.is_active
        && request.resource.data.status == resource.data.status
      );

      allow delete: if isSuperAdmin();

      // Subcollection: Shop-specific settings (delivery fees, financial rules)
      match /settings/{settingId} {
        allow read, write: if isSuperAdmin() || isShopOwner(shopId);
      }
    }

    // =========================================================================
    // 3. PRODUCTS & INVENTORY (Cross-Shop Isolation)
    // =========================================================================
    match /products/{barcode} {
      // Products are publicly readable so customers can browse store catalogs
      allow read: if true;

      // Shop owner can ONLY create products for their own shop_id
      allow create: if isSuperAdmin() || (
        isAuthenticated()
        && request.resource.data.shop_id is string
        && isShopOwner(request.resource.data.shop_id)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 150
        && request.resource.data.price is number
        && request.resource.data.price >= 0
      );

      // Shop owner can update their own shop's products.
      // Customers can atomically update ONLY `stock_quantity` during order placement/cancellation.
      // CRITICAL INVARIANT: stock_quantity can NEVER be negative!
      allow update: if isSuperAdmin() || (
        isAuthenticated() && (
          // 1. Shop Owner updating product attributes (price, name, etc.)
          (
            resource.data.shop_id is string
            && isShopOwner(resource.data.shop_id)
            && request.resource.data.shop_id == resource.data.shop_id
            && request.resource.data.price is number
            && request.resource.data.price >= 0
            && (!('stock_quantity' in request.resource.data) || (request.resource.data.stock_quantity is number && request.resource.data.stock_quantity >= 0))
          ) ||
          // 2. Safe Atomic Stock Reservation during order checkout or order cancellation
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock_quantity'])
            && request.resource.data.stock_quantity is number
            && request.resource.data.stock_quantity >= 0
          )
        )
      );

      allow delete: if isSuperAdmin() || (
        isAuthenticated()
        && resource.data.shop_id is string
        && isShopOwner(resource.data.shop_id)
      );
    }

    // =========================================================================
    // 4. ORDERS COLLECTION (Customer & Shop Multi-Tenant Isolation)
    // =========================================================================
    match /orders/{orderId} {
      // READ PRIVILEGES:
      // 1. Super Admin: Can view all orders
      // 2. Shop Owner: Can ONLY view orders placed at THEIR shop (shop_id == myShop)
      // 3. Customer: Can ONLY view THEIR OWN orders (phone_number == myPhone or customer_uid == myUid)
      // Customer A can NEVER see Customer B's orders!
      // Shop A can NEVER see Shop B's orders!
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          (resource.data.shop_id is string && isShopOwner(resource.data.shop_id)) ||
          isMatchingPhone(resource.data.phone_number) ||
          (('customer_uid' in resource.data) && resource.data.customer_uid == request.auth.uid) ||
          (('delivery_boy_id' in resource.data) && resource.data.delivery_boy_id == request.auth.uid) ||
          (('delivery_boy_phone' in resource.data) && isMatchingPhone(resource.data.delivery_boy_phone))
        )
      );

      // CREATE PRIVILEGES:
      // Customer can place order for their own phone number / UID at a shop.
      // Shop owner can create manual in-store orders for their own shop.
      // Prevents empty orders, enforces Pending status and non-negative total.
      // CRITICAL: Customers CANNOT self-mark order as 'Paid' or 'Refunded'!
      allow create: if isAuthenticated()
                    && request.resource.data.shop_id is string
                    && request.resource.data.total_amount is number
                    && request.resource.data.total_amount >= 0
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.status == 'Pending'
                    && (!('idempotency_key' in request.resource.data) || request.resource.data.idempotency_key is string)
                    && (
                      isSuperAdmin() ||
                      isShopOwner(request.resource.data.shop_id) ||
                      (
                        (!('payment_status' in request.resource.data) || request.resource.data.payment_status in ['Unpaid', 'Payment_Pending', 'Pending_Verification'])
                        && (
                          isMatchingPhone(request.resource.data.phone_number) ||
                          (('customer_uid' in request.resource.data) && request.resource.data.customer_uid == request.auth.uid)
                        )
                      )
                    );

      // UPDATE PRIVILEGES:
      // 1. Super Admin: Full update (can perform authorized administrative corrections)
      // 2. Shop Owner:
      //    - Can only update orders for THEIR shop.
      //    - TERMINAL PROTECTION: If current status is 'Delivered', 'Cancelled', or 'Rejected',
      //      the status CANNOT be reversed or changed back without super admin authorization!
      //    - TRANSITION ENFORCEMENT: All status changes must adhere to isValidOrderTransition!
      // 3. Customer:
      //    - Can cancel their own order if still 'Pending' (can transition to 'Refunded' if already paid).
      //    - Can submit/update UTR reference for payment verification.
      //    - STRICT: Customer can NEVER set payment_status to 'Paid' or alter terminal orders!
      allow update: if isSuperAdmin() || (
        isAuthenticated() && (
          (
            isShopOwner(resource.data.shop_id)
            && request.resource.data.shop_id == resource.data.shop_id
            && (
              // Terminal state protection: Delivered, Cancelled, Rejected cannot be altered by shop owner
              (!(resource.data.status in ['Delivered', 'Cancelled', 'Rejected'])) ||
              (request.resource.data.status == resource.data.status)
            )
            && isValidOrderTransition(resource.data.status, request.resource.data.status)
          ) ||
          (
            (isMatchingPhone(resource.data.phone_number) || (('customer_uid' in resource.data) && resource.data.customer_uid == request.auth.uid))
            && request.resource.data.shop_id == resource.data.shop_id
            && request.resource.data.payment_status != 'Paid'
            && (
              // Option A: Cancel pending order (records Refunded if previously paid)
              (
                resource.data.status == 'Pending'
                && request.resource.data.status == 'Cancelled'
              ) ||
              // Option B: Customer submits/updates UPI reference for payment verification
              (
                request.resource.data.status == resource.data.status
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upi_ref_id', 'payment_status', 'utr_submitted_at'])
                && request.resource.data.payment_status in ['Pending_Verification', 'Payment_Pending']
              )
            )
          ) ||
          (
            // Option C: Assigned Delivery Partner updating order status (Accept -> Pickup -> Delivered)
            (
              (('delivery_boy_id' in resource.data) && resource.data.delivery_boy_id == request.auth.uid) ||
              (('delivery_boy_phone' in resource.data) && isMatchingPhone(resource.data.delivery_boy_phone))
            )
            && request.resource.data.shop_id == resource.data.shop_id
            && isValidOrderTransition(resource.data.status, request.resource.data.status)
          )
        )
      );

      // Orders cannot be deleted arbitrarily to maintain ledger and audit trail
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 5. CUSTOMERS & KHATA TRANSACTIONS (Strict Financial Udhaar Isolation)
    // =========================================================================
    match /customers/{customerId} {
      // READ PRIVILEGES:
      // 1. Super Admin: Can view all customer profiles across platform
      // 2. Customer: Can ONLY view their own customer record (mobile == userPhone or document id == user UID)
      // 3. Shop Owner: Can ONLY view customers that have visited or have an account with THEIR shop
      //    (shop_ids contains myShopId OR shop_id == myShopId)
      //    STRICT ISOLATION: Shop A owner CANNOT see Shop B's customers!
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          isMatchingPhone(resource.data.mobile) ||
          customerId == request.auth.uid ||
          (
            getUserShopId() != '' &&
            isShopOwner(getUserShopId()) &&
            (
              (('shop_ids' in resource.data) && resource.data.shop_ids.hasAny([getUserShopId()])) ||
              (('shop_id' in resource.data) && resource.data.shop_id == getUserShopId())
            )
          )
        )
      );

      // CREATE: Customer registering profile or Shop Owner adding walk-in customer for THEIR shop
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        isMatchingPhone(request.resource.data.mobile) ||
        (
          getUserShopId() != '' &&
          isShopOwner(getUserShopId()) &&
          (
            (('shop_ids' in request.resource.data) && request.resource.data.shop_ids.hasAny([getUserShopId()])) ||
            (('shop_id' in request.resource.data) && request.resource.data.shop_id == getUserShopId())
          )
        )
      );

      // UPDATE:
      // Customer updating their own profile info (name, address)
      // OR Shop Owner updating ledger balance for their own shop
      allow update: if isSuperAdmin() || (
        isAuthenticated() && (
          isMatchingPhone(resource.data.mobile) ||
          customerId == request.auth.uid ||
          (
            getUserShopId() != '' &&
            isShopOwner(getUserShopId()) &&
            (
              ('shop_ids' in resource.data && resource.data.shop_ids.hasAny([getUserShopId()])) ||
              ('shop_ids' in request.resource.data && request.resource.data.shop_ids.hasAny([getUserShopId()])) ||
              ('shop_id' in resource.data && resource.data.shop_id == getUserShopId())
            )
          )
        )
      );

      allow delete: if isSuperAdmin();

      // Subcollection: Khata Transactions (Udhaar / Jama Statement)
      match /khata_transactions/{txId} {
        // READ:
        // Customer can read their own transactions.
        // Shop Owner can ONLY read transactions belonging to THEIR shop_id.
        // Shop A CANNOT read Khata transactions belonging to Shop B!
        allow read: if isSuperAdmin() || (
          isAuthenticated() && (
            isMatchingPhone(get(/databases/$(database)/documents/customers/$(customerId)).data.mobile) ||
            (resource.data.shop_id is string && isShopOwner(resource.data.shop_id))
          )
        );

        // CREATE:
        // Only Shop Owner can add Khata entries, and ONLY for their own shop_id.
        // Customer CANNOT self-credit or alter their own khata.
        allow create: if isSuperAdmin() || (
          isAuthenticated()
          && request.resource.data.shop_id is string
          && isShopOwner(request.resource.data.shop_id)
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.type in ['debit', 'credit', 'udhaar', 'jama']
        );

        // UPDATE / DELETE:
        // Shop Owner can only modify or delete transactions belonging to their own shop.
        allow update, delete: if isSuperAdmin() || (
          isAuthenticated()
          && resource.data.shop_id is string
          && isShopOwner(resource.data.shop_id)
        );
      }
    }

    // =========================================================================
    // 6. GLOBAL SETTINGS
    // =========================================================================
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 7. PUSH NOTIFICATIONS & DEVICE TOKENS (Feature 41)
    // =========================================================================
    match /device_tokens/{tokenId} {
      // Users can manage their own device FCM registration tokens
      allow read: if isSuperAdmin() || (isAuthenticated() && (
        resource.data.uid == request.auth.uid ||
        isMatchingPhone(resource.data.phone)
      ));
      allow create, update: if isAuthenticated() && (
        request.resource.data.uid == request.auth.uid ||
        isMatchingPhone(request.resource.data.phone)
      );
      allow delete: if isSuperAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    match /notifications/{notificationId} {
      // Users can read notifications directed to their phone or UID
      // Shop owners can read notifications addressed to their shop
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          (resource.data.recipient_uid == request.auth.uid) ||
          isMatchingPhone(resource.data.recipient_phone) ||
          (resource.data.shop_id is string && isShopOwner(resource.data.shop_id))
        )
      );
      allow create: if isAuthenticated()
                    && request.resource.data.title is string
                    && request.resource.data.body is string;
      allow update: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.recipient_uid == request.auth.uid ||
          isMatchingPhone(resource.data.recipient_phone)
        )
      );
      allow delete: if isSuperAdmin();
    }

    match /notification_queue/{queueId} {
      allow read: if isSuperAdmin() || isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 8. PAYMENT TRANSACTIONS & RECONCILIATION LEDGER (Feature 42)
    // =========================================================================
    match /payment_transactions/{txnId} {
      // Super admin can read & write any payment transaction
      // Shop owner can read transactions for their shop
      // Customer can read transactions for their phone / UID
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          (resource.data.shop_id is string && isShopOwner(resource.data.shop_id)) ||
          isMatchingPhone(resource.data.customer_phone) ||
          (('customer_uid' in resource.data) && resource.data.customer_uid == request.auth.uid)
        )
      );

      // Authenticated checkout can create initial payment transactions
      allow create: if isAuthenticated()
                    && request.resource.data.amount is number
                    && request.resource.data.amount >= 0
                    && request.resource.data.order_id is string;

      // Shop owners can verify or update payments for their shop; Super Admin can manage all
      allow update: if isSuperAdmin() || (
        isAuthenticated()
        && resource.data.shop_id is string
        && isShopOwner(resource.data.shop_id)
      );

      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 9. CRASH REPORTS & ACTIONABLE TELEMETRY (Feature 44)
    // =========================================================================
    match /crash_reports/{reportId} {
      // Super admin can inspect all production crash logs
      allow read: if isSuperAdmin();
      // Any client session or app instance can submit crash and error logs
      allow create: if true;
      // Protected updates and deletes
      allow update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // 10. RETURNS, REFUNDS & COMPLAINTS (Feature 51)
    // =========================================================================
    match /complaints/{complaintId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          (resource.data.shop_id is string && isShopOwner(resource.data.shop_id)) ||
          isMatchingPhone(resource.data.customer_phone) ||
          (('customer_uid' in resource.data) && resource.data.customer_uid == request.auth.uid)
        )
      );

      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.resource.data.shop_id is string && isShopOwner(request.resource.data.shop_id)) ||
        isMatchingPhone(request.resource.data.customer_phone) ||
        (('customer_uid' in request.resource.data) && request.resource.data.customer_uid == request.auth.uid)
      );

      allow update: if isSuperAdmin() || (
        isAuthenticated() && (
          (resource.data.shop_id is string && isShopOwner(resource.data.shop_id)) ||
          (
            (isMatchingPhone(resource.data.customer_phone) || (('customer_uid' in resource.data) && resource.data.customer_uid == request.auth.uid))
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
          )
        )
      );

      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 11. SHOPPING LISTS & REORDER (Feature 52)
    // =========================================================================
    match /shopping_lists/{listId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          isMatchingPhone(resource.data.customer_phone) ||
          (('shop_id' in resource.data) && isShopOwner(resource.data.shop_id))
        )
      );

      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        isMatchingPhone(request.resource.data.customer_phone)
      );

      allow update: if isSuperAdmin() || (
        isAuthenticated() && isMatchingPhone(resource.data.customer_phone)
      );

      allow delete: if isSuperAdmin() || (
        isAuthenticated() && isMatchingPhone(resource.data.customer_phone)
      );
    }

    // =========================================================================
    // 12. STORE OPERATING EXPENSES (Feature 53: Sales & Profit Analytics)
    // =========================================================================
    match /expenses/{expenseId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          (resource.data.shop_id is string && isShopOwner(resource.data.shop_id))
        )
      );

      allow create: if isSuperAdmin() || (
        isAuthenticated() && (
          request.resource.data.shop_id is string &&
          isShopOwner(request.resource.data.shop_id) &&
          request.resource.data.amount is number &&
          request.resource.data.amount >= 0
        )
      );

      allow update: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string &&
          isShopOwner(resource.data.shop_id) &&
          request.resource.data.shop_id == resource.data.shop_id &&
          request.resource.data.amount is number &&
          request.resource.data.amount >= 0
        )
      );

      allow delete: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string &&
          isShopOwner(resource.data.shop_id)
        )
      );
    }

    // =========================================================================
    // 13. SUPPLIER & PURCHASE MANAGEMENT (Feature 54)
    // =========================================================================
    match /suppliers/{supplierId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string && isShopOwner(resource.data.shop_id)
        )
      );

      allow create: if isSuperAdmin() || (
        isAuthenticated() && (
          request.resource.data.shop_id is string &&
          isShopOwner(request.resource.data.shop_id) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.phone is string
        )
      );

      allow update: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string &&
          isShopOwner(resource.data.shop_id) &&
          request.resource.data.shop_id == resource.data.shop_id
        )
      );

      allow delete: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string &&
          isShopOwner(resource.data.shop_id)
        )
      );
    }

    match /purchase_orders/{purchaseId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string && isShopOwner(resource.data.shop_id)
        )
      );

      allow create: if isSuperAdmin() || (
        isAuthenticated() && (
          request.resource.data.shop_id is string &&
          isShopOwner(request.resource.data.shop_id) &&
          request.resource.data.supplier_id is string &&
          request.resource.data.total_amount is number &&
          request.resource.data.total_amount >= 0
        )
      );

      allow update: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string &&
          isShopOwner(resource.data.shop_id) &&
          request.resource.data.shop_id == resource.data.shop_id
        )
      );

      allow delete: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string &&
          isShopOwner(resource.data.shop_id)
        )
      );
    }

    match /supplier_payments/{paymentId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string && isShopOwner(resource.data.shop_id)
        )
      );

      allow create: if isSuperAdmin() || (
        isAuthenticated() && (
          request.resource.data.shop_id is string &&
          isShopOwner(request.resource.data.shop_id) &&
          request.resource.data.supplier_id is string &&
          request.resource.data.amount is number &&
          request.resource.data.amount > 0
        )
      );

      allow update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // 14. EXPIRY & BATCH TRACKING (Feature 55)
    // =========================================================================
    match /product_batches/{batchId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string && isShopOwner(resource.data.shop_id)
        )
      );

      allow create: if isSuperAdmin() || (
        isAuthenticated() && (
          request.resource.data.shop_id is string &&
          isShopOwner(request.resource.data.shop_id) &&
          request.resource.data.batch_number is string &&
          request.resource.data.quantity is number
        )
      );

      allow update: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string &&
          isShopOwner(resource.data.shop_id) &&
          request.resource.data.shop_id == resource.data.shop_id
        )
      );

      allow delete: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string &&
          isShopOwner(resource.data.shop_id)
        )
      );
    }

    match /batch_disposals/{disposalId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string && isShopOwner(resource.data.shop_id)
        )
      );

      allow create: if isSuperAdmin() || (
        isAuthenticated() && (
          request.resource.data.shop_id is string &&
          isShopOwner(request.resource.data.shop_id) &&
          request.resource.data.quantity_disposed is number &&
          request.resource.data.quantity_disposed > 0
        )
      );

      allow update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // 15. STAFF ACCOUNTS & AUDIT LOGS (Controlled Delegation & Immutable Audit)
    // =========================================================================
    match /staff_members/{staffId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          (resource.data.shop_id is string && isShopOwner(resource.data.shop_id)) ||
          (resource.data.phone is string && isMatchingPhone(resource.data.phone))
        )
      );

      allow create: if isSuperAdmin() || (
        isAuthenticated() && (
          request.resource.data.shop_id is string &&
          isShopOwner(request.resource.data.shop_id) &&
          request.resource.data.name is string &&
          request.resource.data.phone is string
        )
      );

      allow update: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string &&
          isShopOwner(resource.data.shop_id) &&
          request.resource.data.shop_id == resource.data.shop_id
        )
      );

      allow delete: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string &&
          isShopOwner(resource.data.shop_id)
        )
      );
    }

    match /audit_logs/{logId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string && isShopOwner(resource.data.shop_id)
        )
      );

      allow create: if isSuperAdmin() || (
        isAuthenticated() && (
          request.resource.data.shop_id is string &&
          request.resource.data.action_type is string
        )
      );

      // Audit logs are strictly immutable: cannot be modified or deleted by normal users!
      allow update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // 16. DATA EXPORTS & CLOUD BACKUPS (Feature 57: Snapshots & Disaster Recovery)
    // Multi-tenant isolation: Only shop owners or super admins can read, create,
    // update (for restore test results), or delete backups for their own shop_id.
    // =========================================================================
    match /backups/{backupId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string && isShopOwner(resource.data.shop_id)
        )
      );

      allow create: if isSuperAdmin() || (
        isAuthenticated() && (
          request.resource.data.shop_id is string && isShopOwner(request.resource.data.shop_id)
        )
      );

      allow update: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string && isShopOwner(resource.data.shop_id)
        )
      );

      allow delete: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string && isShopOwner(resource.data.shop_id)
        )
      );
    }

    // =========================================================================
    // 17. DELIVERY PARTNER MODE (Feature 58: Dedicated Dispatch Workflow)
    // Multi-tenant isolation: Shop owners can manage delivery partners for their shop.
    // Delivery partners can view and update their own status/profile.
    // =========================================================================
    match /delivery_partners/{partnerId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          (resource.data.shop_id is string && isShopOwner(resource.data.shop_id)) ||
          (resource.data.phone is string && isMatchingPhone(resource.data.phone)) ||
          (partnerId == request.auth.uid)
        )
      );

      allow create: if isSuperAdmin() || (
        isAuthenticated() && (
          (request.resource.data.shop_id is string && isShopOwner(request.resource.data.shop_id)) ||
          (request.resource.data.phone is string && isMatchingPhone(request.resource.data.phone)) ||
          (partnerId == request.auth.uid)
        )
      );

      allow update: if isSuperAdmin() || (
        isAuthenticated() && (
          (resource.data.shop_id is string && isShopOwner(resource.data.shop_id)) ||
          (resource.data.phone is string && isMatchingPhone(resource.data.phone)) ||
          (partnerId == request.auth.uid)
        )
      );

      allow delete: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string && isShopOwner(resource.data.shop_id)
        )
      );
    }

    // =========================================================================
    // 18. LIVE DELIVERY TRACKING (Feature 59: Real-time GPS Location)
    // - Read: Allowed for shop owners, assigned delivery partner, or the customer
    //   matching the order (by customer_phone or auth uid).
    // - Create/Update: Allowed for shop owners and assigned delivery partner.
    // - Delete: Super admin or shop owner.
    // =========================================================================
    match /delivery_tracking/{orderId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          (resource.data.shop_id is string && isShopOwner(resource.data.shop_id)) ||
          (resource.data.partner_phone is string && isMatchingPhone(resource.data.partner_phone)) ||
          (resource.data.customer_phone is string && isMatchingPhone(resource.data.customer_phone)) ||
          (resource.data.partner_id == request.auth.uid) ||
          (resource.data.customer_uid == request.auth.uid)
        )
      );

      allow create: if isSuperAdmin() || (
        isAuthenticated() && (
          (request.resource.data.shop_id is string && isShopOwner(request.resource.data.shop_id)) ||
          (request.resource.data.partner_phone is string && isMatchingPhone(request.resource.data.partner_phone)) ||
          (request.resource.data.partner_id == request.auth.uid)
        )
      );

      allow update: if isSuperAdmin() || (
        isAuthenticated() && (
          (resource.data.shop_id is string && isShopOwner(resource.data.shop_id)) ||
          (resource.data.partner_phone is string && isMatchingPhone(resource.data.partner_phone)) ||
          (resource.data.partner_id == request.auth.uid)
        )
      );

      allow delete: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string && isShopOwner(resource.data.shop_id)
        )
      );
    }

    // =========================================================================
    // 19. LOYALTY & REFERRAL PROGRAM (Feature 60)
    // - Configs (/loyalty_configs/{shopId}):
    //   Read allowed for authenticated users; write restricted to shop owner or super admin.
    // - Accounts (/loyalty_accounts/{accountId}):
    //   Read allowed for customer matching phone/uid or shop owner.
    //   Create/Update allowed for shop owner or authenticated customer.
    // - Transactions (/loyalty_transactions/{txId}):
    //   Read allowed for customer or shop owner.
    // - Referrals (/referrals/{referralId}):
    //   Read allowed for referrer, referee, or shop owner.
    // =========================================================================
    match /loyalty_configs/{shopId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin() || isShopOwner(shopId);
    }

    match /loyalty_accounts/{accountId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          (resource.data.shop_id is string && isShopOwner(resource.data.shop_id)) ||
          (resource.data.customer_phone is string && isMatchingPhone(resource.data.customer_phone)) ||
          (resource.data.customer_uid == request.auth.uid)
        )
      );

      allow create, update: if isSuperAdmin() || (
        isAuthenticated() && (
          (request.resource.data.shop_id is string && isShopOwner(request.resource.data.shop_id)) ||
          (request.resource.data.customer_phone is string && isMatchingPhone(request.resource.data.customer_phone)) ||
          (request.resource.data.customer_uid == request.auth.uid)
        )
      );

      allow delete: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string && isShopOwner(resource.data.shop_id)
        )
      );
    }

    match /loyalty_transactions/{txId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          (resource.data.shop_id is string && isShopOwner(resource.data.shop_id)) ||
          (resource.data.customer_phone is string && isMatchingPhone(resource.data.customer_phone)) ||
          (resource.data.customer_uid == request.auth.uid)
        )
      );

      allow create: if isSuperAdmin() || (
        isAuthenticated() && (
          (request.resource.data.shop_id is string && isShopOwner(request.resource.data.shop_id)) ||
          (request.resource.data.customer_phone is string && isMatchingPhone(request.resource.data.customer_phone)) ||
          (request.resource.data.customer_uid == request.auth.uid)
        )
      );

      allow update, delete: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string && isShopOwner(resource.data.shop_id)
        )
      );
    }

    match /referrals/{referralId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          (resource.data.shop_id is string && isShopOwner(resource.data.shop_id)) ||
          (resource.data.referrer_phone is string && isMatchingPhone(resource.data.referrer_phone)) ||
          (resource.data.referee_phone is string && isMatchingPhone(resource.data.referee_phone))
        )
      );

      allow create, update: if isSuperAdmin() || (
        isAuthenticated() && (
          (request.resource.data.shop_id is string && isShopOwner(request.resource.data.shop_id)) ||
          (request.resource.data.referrer_phone is string && isMatchingPhone(request.resource.data.referrer_phone)) ||
          (request.resource.data.referee_phone is string && isMatchingPhone(request.resource.data.referee_phone))
        )
      );

      allow delete: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string && isShopOwner(resource.data.shop_id)
        )
      );
    }

    // =========================================================================
    // 20. VOICE-BASED GROCERY ORDERING (Feature 61)
    // - Logs (/voice_order_logs/{logId}):
    //   Read allowed for customer matching phone, shop owner, or super admin.
    //   Create allowed for authenticated users.
    //   Update/Delete restricted to shop owner or super admin.
    // =========================================================================
    match /voice_order_logs/{logId} {
      allow read: if isSuperAdmin() || (
        isAuthenticated() && (
          (resource.data.shop_id is string && isShopOwner(resource.data.shop_id)) ||
          (resource.data.customer_phone is string && isMatchingPhone(resource.data.customer_phone))
        )
      );

      allow create: if isSuperAdmin() || isAuthenticated();

      allow update, delete: if isSuperAdmin() || (
        isAuthenticated() && (
          resource.data.shop_id is string && isShopOwner(resource.data.shop_id)
        )
      );
    }

    // =========================================================================
    // 21. DELIVERY PARTNERS & DISPATCHES
    // =========================================================================
    match /delivery_partners/{partnerId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isSuperAdmin() || isAuthenticated();
    }

    match /delivery_tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isSuperAdmin() || isAuthenticated();
    }

    // Fallback: Deny all unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }

  }
}

