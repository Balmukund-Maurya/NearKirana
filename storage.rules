rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public read for store logos and product catalog images
    match /products/{shopId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Store QR codes, branding, and receipts
    match /shops/{shopId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Customer receipts or complaint proof images
    match /complaints/{complaintId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Default fallback deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
